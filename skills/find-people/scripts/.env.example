# find-people API keys. Both are optional; the skill has a manual fallback without them.
# Copy this file to your WORKSPACE (not the plugin folder): $JOB_HUNT_HOME/.env or ./job-hunt/.env
# then fill in values and run: chmod 600 .env   Environment variables of the same name take precedence.
# Hunter: hunter.io -> API. Used for domain-search (candidates) and email-verifier (SMTP gate).
HUNTER_API_KEY=your-hunter-api-key-here
# Apollo.io: apollo.io -> Settings -> API. Resolves named ICs that Hunter misses.
APOLLO_API_KEY=your-apollo-api-key-here
